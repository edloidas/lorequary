{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite-plus/test/globals"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "files": ["vite.config.ts"],
  "include": ["src", "config"]
}
