{
  "name": "@lorequary/core",
  "version": "0.1.0",
  "description": "Shared domain schema, serialization, validation, and graph traversal for Lorequary dialogues",
  "author": "Mikita Taukachou",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "vp check && vp run typecheck",
    "check:fix": "vp check --fix && vp run typecheck",
    "clean": "rm -rf dist coverage reports",
    "typecheck": "tsc --noEmit",
    "test": "vp test --run",
    "test:ci": "vp test --run --coverage"
  },
  "dependencies": {
    "@lorequary/parser": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
