{
  "name": "lorequary",
  "version": "0.1.0",
  "author": "Mikita Taukachou <edloidas@gmail.com> (https://edloidas.io)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @lorequary/web run build",
    "check": "pnpm -r --parallel run check",
    "check:fix": "pnpm -r --parallel run check:fix",
    "test": "pnpm -r --parallel run test",
    "test:ci": "pnpm -r --parallel run test:ci",
    "dev": "pnpm --filter @lorequary/web exec vp dev"
  },
  "engines": {
    "node": ">= 26.8.1",
    "pnpm": ">= 12.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
